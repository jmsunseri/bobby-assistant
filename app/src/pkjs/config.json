                    {"label": "Suomi", "value": "fi_FI"},
                    {"label": "Svenska", "value": "sv_SE"},
                    {"label": "Türkçe", "value": "tr_TR"},
                    {"label": "IsiZulu", "value": "zu-ZA"}
                ]
            },
            {
                "type": "select",
                "id": "unitPreference",
                "messageKey": "UNIT_PREFERENCE",
                "label": "Unit preference",
                "description": "Your preferred units. If 'both', units will be provided in both systems.",
                "defaultValue": "",
                "options": [
                    {"label": "Automatic", "value": ""},
                    {"label": "Metric", "value": "metric"},
                    {"label": "Imperial", "value": "imperial"},
                    {"label": "UK", "value": "uk"},
                    {"label": "Both", "value": "both"}
                ]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Behaviour"
            },
            {
                "type": "select",
                "messageKey": "ALARM_VIBE_PATTERN",
                "label": "Alarm vibration",
                "defaultValue": "5",
                "options": [
                    {"label": "Reveille", "value": "1"},
                    {"label": "Mario", "value": "2"},
                    {"label": "Nudge Nudge", "value": "3"},
                    {"label": "Jackhammer", "value": "4"},
                    {"label": "Standard", "value": "5"}
                ]
            },
            {
                "type": "select",
                "messageKey": "TIMER_VIBE_PATTERN",
                "label": "Timer vibration",
                "defaultValue": "5",
                "options": [
                    {"label": "Reveille", "value": "1"},
                    {"label": "Mario", "value": "2"},
                    {"label": "Nudge Nudge", "value": "3"},
                    {"label": "Jackhammer", "value": "4"},
                    {"label": "Standard", "value": "5"}
                ]
            },
            {
                "type": "select",
                "messageKey": "QUICK_LAUNCH_BEHAVIOUR",
                "label": "Quick launch behaviour",
                "description": "What to do when Bobby is launched via Quick Launch. If 'start conversation' is selected, Bobby will start listening immediately. If 'stay open' is chosen, Bobby will quit after a minute of inactivity. If 'open home screen' is chosen, Bobby will behave the same as if launched from the app launcher.",
                "defaultValue": "1",
                "options": [
                    {"label": "Start conversation and time out", "value": "1"},
                    {"label": "Start conversation then stay open", "value": "2"},
                    {"label": "Open home screen", "value": "3"}
                ]
            },
            {
                "type": "toggle",
                "messageKey": "CONFIRM_TRANSCRIPTS",
                "defaultValue": false,
                "label": "Confirm prompts before responding",
                "description": "When enabled, after dictating to the watch, you'll always be asked to confirm your input before Bobby takes action. When disabled, Bobby will respond immediately to whatever was recognised."
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Permissions"
            },
            {
                "type": "toggle",
                "messageKey": "LOCATION_ENABLED",
                "defaultValue": true,
                "label": "Allow location access",
                "description": "Bobby can use your location to provide contextually relevant information, including local weather and transit as well as more broadly understanding your local context."
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Cloudflare"
            },
            {
                "type": "text",
                "defaultValue": "Bobby now runs the agent loop on your phone. Prompts go directly from the phone to Cloudflare Workers AI using the account below. No Bobby or Rebble server is involved."
            },
            {
                "type": "input",
                "id": "cfAccount",
                "messageKey": "CF_ACCOUNT_ID",
                "label": "Cloudflare account ID",
                "defaultValue": "",
                "attributes": {
                    "placeholder": "Your 32-character account ID"
                }
            },
            {
                "type": "input",
                "id": "cfToken",
                "messageKey": "CF_API_TOKEN",
                "group": "secret",
                "label": "Cloudflare API token",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "placeholder": "A token with Workers AI access"
                }
            },
            {
                "type": "toggle",
                "id": "cfPaid",
                "messageKey": "CF_PAID_PLAN",
                "defaultValue": true,
                "label": "Workers Paid plan",
                "description": "Some Workers AI models require a paid plan. Turn this off to show only free-plan models."
            },
            {
                "type": "select",
                "id": "cfModel",
                "messageKey": "CF_MODEL",
                "label": "Language model",
                "description": "Used for open-ended chat and for summarising tool results. Clef and Clairic handle routing and extraction.",
                "defaultValue": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
                "options": [
                    {"label": "DeepSeek V4.1 Flash (paid)", "value": "@cf/deepseek-ai/deepseek-v4.1-flash-1017"},
                    {"label": "Inkling 2 Small (paid)", "value": "@cf/thinkingmachines/inkling-2-small"},
                    {"label": "GLM-5.3 (paid)", "value": "@cf/zai-org/glm-5.3"},
                    {"label": "Qwen 3.8 27B (free plan)", "value": "@cf/qwen/qwen3.8-27b"},
                    {"label": "Gemma 4 26B (free plan)", "value": "@cf/google/gemma-4-26b-a4b-it"}
                ]
            },
            {
                "type": "select",
                "id": "cfEffort",
                "messageKey": "CF_REASONING_EFFORT",
                "label": "Reasoning effort",
                "description": "Low keeps watch replies fast. High can make the model think for several seconds.",
                "defaultValue": "low",
                "options": [
                    {"label": "None", "value": "none"},
                    {"label": "Low", "value": "low"},
                    {"label": "High", "value": "high"}
                ]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Optional tools"
            },
            {
                "type": "text",
                "defaultValue": "Tools whose key is missing are hidden from the assistant. API keys stay on your phone and are never sent to the watch."
            },
            {
                "type": "toggle",
                "id": "showSecrets",
                "defaultValue": false,
                "label": "Show API keys"
            },
            {
                "type": "input",
                "id": "braveKey",
                "messageKey": "BRAVE_API_KEY",
                "group": "secret",
                "label": "Brave Search API key",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "placeholder": "Optional: enables web search"
                }
            },
            {
                "type": "input",
                "id": "exchangeKey",
                "messageKey": "EXCHANGE_RATE_API_KEY",
                "group": "secret",
                "label": "ExchangeRate-API key",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "placeholder": "Optional: enables currency conversion"
                }
            },
            {
                "type": "input",
                "id": "mapboxToken",
                "messageKey": "MAPBOX_TOKEN",
                "group": "secret",
                "label": "Mapbox token",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "placeholder": "Optional: better place-name geocoding"
                }
            }
        ]
    },
    {
        "type": "submit",
        "defaultValue": "Save"
    }
]
